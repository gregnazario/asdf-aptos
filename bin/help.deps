#!/usr/bin/env bash

printf "%s\n" "
# Aptos CLI Dependencies

## macOS
- unzip (included with macOS)

## Linux
- unzip (install via your package manager if not present)

## Windows
- Not supported by this plugin
- Use WSL2 for Windows users

## Notes
- The plugin downloads pre-built ZIP binaries and extracts them with unzip
- No Rust toolchain or other build dependencies needed
"
